--// =========================================================
--// Error Stack Position
--// =========================================================

local function getErrorStackPosition(
    stackIndex
)

    local camera =
        workspace.CurrentCamera

    local viewport =
        camera
        and camera.ViewportSize
        or Vector2.new(
            1920,
            1080
        )

    local width =
        ERROR_DEFAULT_WIDTH

    local height =
        ERROR_DEFAULT_HEIGHT

    local centerX =
        (
            viewport.X -
            width
        ) / 2

    local centerY =
        (
            viewport.Y -
            height
        ) / 2

    local offsetIndex =
        stackIndex - 1

    local x =
        centerX +
        (
            offsetIndex *
            ERROR_STACK_OFFSET_X
        )

    local y =
        centerY +
        (
            offsetIndex *
            ERROR_STACK_OFFSET_Y
        )

    local maxX =
        viewport.X -
        width -
        ERROR_SCREEN_MARGIN

    local maxY =
        viewport.Y -
        height -
        ERROR_SCREEN_MARGIN

    x =
        math.clamp(
            x,
            ERROR_SCREEN_MARGIN,
            math.max(
                ERROR_SCREEN_MARGIN,
                maxX
            )
        )

    y =
        math.clamp(
            y,
            ERROR_SCREEN_MARGIN,
            math.max(
                ERROR_SCREEN_MARGIN,
                maxY
            )
        )

    return UDim2.fromOffset(
        x,
        y
    )
end

