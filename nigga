--// =========================================================
--// Dragging
--// =========================================================

local function enableDragging(
    window,
    titleBar,
    windowType
)

    local dragging = false

    local dragStart
    local startPosition

    titleBar.InputBegan:Connect(
        function(input)

            if guiClosed then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton1
                and input.UserInputType
                ~= Enum.UserInputType.Touch then

                return
            end

            dragging = true

            dragStart =
                input.Position

            startPosition =
                window.Position
        end
    )

    titleBar.InputEnded:Connect(
        function(input)

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton1
                and input.UserInputType
                ~= Enum.UserInputType.Touch then

                return
            end

            dragging = false
        end
    )

    UserInputService.InputChanged:Connect(
        function(input)

            if not dragging then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseMovement
                and input.UserInputType
                ~= Enum.UserInputType.Touch then

                return
            end

            local delta =
                input.Position -
                dragStart

            window.Position =
                UDim2.new(
                    startPosition.X.Scale,
                    startPosition.X.Offset +
                        delta.X,

                    startPosition.Y.Scale,
                    startPosition.Y.Offset +
                        delta.Y
                )

            if windowType == "main"
                and not mainMaximized
                and not mainMinimized then

                mainNormalPosition =
                    window.Position
            end

            if windowType == "settings"
                and not settingsMaximized
                and not settingsMinimized then

                settingsNormalPosition =
                    window.Position
            end
        end
    )
end

--// =========================================================
--// Resizing
--// Invisible resize handles
--// =========================================================

local function enableResizing(
    window,
    handle,
    minWidth,
    minHeight,
    maxWidth,
    maxHeight,
    windowType
)

    local resizing = false

    local resizeStart
    local resizeStartSize

    -- Invisible handle, cursor appears only on hover.
    handle.MouseEnter:Connect(
        function()

            if not resizing then
                setResizeCursor(true)
            end
        end
    )

    handle.MouseLeave:Connect(
        function()

            if not resizing then
                setResizeCursor(false)
            end
        end
    )

    handle.InputBegan:Connect(
        function(input)

            if guiClosed then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton1
                and input.UserInputType
                ~= Enum.UserInputType.Touch then

                return
            end

            resizing = true

            setResizeCursor(true)

            resizeStart =
                input.Position

            resizeStartSize =
                Vector2.new(
                    window.AbsoluteSize.X,
                    window.AbsoluteSize.Y
                )
        end
    )

    handle.InputEnded:Connect(
        function(input)

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton1
                and input.UserInputType
                ~= Enum.UserInputType.Touch then

                return
            end

            resizing = false

            setResizeCursor(false)
        end
    )

    UserInputService.InputChanged:Connect(
        function(input)

            if not resizing then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseMovement
                and input.UserInputType
                ~= Enum.UserInputType.Touch then

                return
            end

            local delta =
                input.Position -
                resizeStart

            local width =
                math.clamp(
                    resizeStartSize.X +
                        delta.X,

                    minWidth,
                    maxWidth
                )

            local height =
                math.clamp(
                    resizeStartSize.Y +
                        delta.Y,

                    minHeight,
                    maxHeight
                )

            window.Size =
                UDim2.fromOffset(
                    width,
                    height
                )

            if windowType == "main"
                and not mainMinimized
                and not mainMaximized then

                mainRestoreSize =
                    UDim2.fromOffset(
                        width,
                        height
                    )

                mainNormalSize =
                    mainRestoreSize

                mainNormalPosition =
                    mainWindow.Position
            end

            if windowType == "settings"
                and not settingsMinimized
                and not settingsMaximized then

                settingsNormalSize =
                    UDim2.fromOffset(
                        width,
                        height
                    )

                settingsNormalPosition =
                    settingsWindow.Position
            end
        end
    )
end

--// =========================================================
--// Live in-game inventory check
--// =========================================================

local function hasEquinoxCannon()

    -- Equipped tool
    local character =
        player.Character

    if character then

        local equippedTool =
            character:FindFirstChild(
                "Equinox Cannon"
            )

        if equippedTool
            and equippedTool:IsA("Tool") then

            return true
        end
    end

    -- Backpack inventory
    local backpack =
        player:FindFirstChildOfClass(
            "Backpack"
        )

    if backpack then

        local inventoryTool =
            backpack:FindFirstChild(
                "Equinox Cannon"
            )

        if inventoryTool
            and inventoryTool:IsA("Tool") then

            return true
        end
    end

    return false
end

--// =========================================================
--// State Helpers
--// =========================================================

local function isPlayerAlive()

    if not player.Character then
        return false
    end

    local humanoid =
        player.Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return false
    end

    return humanoid.Health > 0
end

local function updateStatus()

    if not statusValue
        or not statusDot then

        return
    end

    if State.isRunning then

        statusValue.Text = "ON"

        statusValue.TextColor3 =
            XP.GreenDark

        statusDot.BackgroundColor3 =
            XP.Green

        statusDot.BorderColor3 =
            XP.GreenDark

    else

        statusValue.Text = "OFF"

        statusValue.TextColor3 =
            XP.RedDark

        statusDot.BackgroundColor3 =
            XP.Red

        statusDot.BorderColor3 =
            XP.RedDark
    end
end

local function updateTarget()

    if not targetValue then
        return
    end

    local targetName =
        State.currentTargetName

    if not targetName
        or targetName == "" then

        targetName = "None"
    end

    targetValue.Text =
        targetName
end

local function updateAutoEquip()

    if not autoEquipCheck then
        return
    end

    autoEquipCheck.Visible =
        State.autoEquip == true
end

--// =========================================================
--// Error stack position
--//
--// First error = centered.
--// Each additional error cascades down/right.
--// When the screen edge is reached, it stays clamped.
--// =========================================================

local function getErrorStackPosition(stackIndex)

    local camera =
        workspace.CurrentCamera

    local viewport =
        camera
        and camera.ViewportSize
        or Vector2.new(
            1920,
            1080
        )

    local width =
        ERROR_DEFAULT_WIDTH

    local height =
        ERROR_DEFAULT_HEIGHT

    -- First window opens in the exact center.
    local centerX =
        (viewport.X - width) / 2

    local centerY =
        (viewport.Y - height) / 2

    local offsetIndex =
        stackIndex - 1

    local x =
        centerX +
        (
            offsetIndex *
            ERROR_STACK_OFFSET_X
        )

    local y =
        centerY +
        (
            offsetIndex *
            ERROR_STACK_OFFSET_Y
        )

    -- Clamp toward bottom-right once
    -- the normal cascade reaches the edge.
    local maxX =
        viewport.X -
        width -
        ERROR_SCREEN_MARGIN

    local maxY =
        viewport.Y -
        height -
        ERROR_SCREEN_MARGIN

    x =
        math.clamp(
            x,
            ERROR_SCREEN_MARGIN,
            math.max(
                ERROR_SCREEN_MARGIN,
                maxX
            )
        )

    y =
        math.clamp(
            y,
            ERROR_SCREEN_MARGIN,
            math.max(
                ERROR_SCREEN_MARGIN,
                maxY
            )
        )

    return UDim2.fromOffset(
        x,
        y
    )
end

