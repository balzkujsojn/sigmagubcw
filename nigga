            if windowType == "settings"
                and not settingsMaximized
                and not settingsMinimized then

                settingsNormalPosition =
                    window.Position
            end
        end
    )
end

--// =========================================================
--// Resizing
--// =========================================================

local function enableResizing(
    window,
    handle,
    minWidth,
    minHeight,
    maxWidth,
    maxHeight,
    windowType
)

    local resizing = false

    local resizeStart
    local resizeStartSize

    handle.MouseEnter:Connect(
        function()

            if not resizing then
                setResizeCursor(true)
            end
        end
    )

    handle.MouseLeave:Connect(
        function()

            if not resizing then
                setResizeCursor(false)
            end
        end
    )

    handle.InputBegan:Connect(
        function(input)

            if guiClosed then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton1
                and input.UserInputType
                ~= Enum.UserInputType.Touch then

                return
            end

            resizing = true

            setResizeCursor(true)

            resizeStart =
                input.Position

            resizeStartSize =
                Vector2.new(
                    window.AbsoluteSize.X,
                    window.AbsoluteSize.Y
                )
        end
    )

    handle.InputEnded:Connect(
        function(input)

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton1
                and input.UserInputType
                ~= Enum.UserInputType.Touch then

                return
            end

            resizing = false

            setResizeCursor(false)
        end
    )

    UserInputService.InputChanged:Connect(
        function(input)

            if not resizing then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseMovement
                and input.UserInputType
                ~= Enum.UserInputType.Touch then

                return
            end

            local delta =
                input.Position -
                resizeStart

            local width =
                math.clamp(
                    resizeStartSize.X +
                        delta.X,
                    minWidth,
                    maxWidth
                )

            local height =
                math.clamp(
                    resizeStartSize.Y +
                        delta.Y,
                    minHeight,
                    maxHeight
                )

            window.Size =
                UDim2.fromOffset(
                    width,
                    height
                )

            if windowType == "main"
                and not mainMinimized
                and not mainMaximized then

                mainRestoreSize =
                    UDim2.fromOffset(
                        width,
                        height
                    )

                mainNormalSize =
                    mainRestoreSize

                mainNormalPosition =
                    mainWindow.Position
            end

            if windowType == "settings"
                and not settingsMinimized
                and not settingsMaximized then

                settingsNormalSize =
                    UDim2.fromOffset(
                        width,
                        height
                    )

                settingsNormalPosition =
                    settingsWindow.Position
            end
        end
    )
end

