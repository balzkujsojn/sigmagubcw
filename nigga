                            true

                        settingsResizeHandle.Visible =
                            true

                        settingsMinimized =
                            false

                        settingsMaximized =
                            false
                    end
                end
            )
        end
    )
end

--// =========================================================
--// Open Settings
--// =========================================================

local function openSettings()

    if not settingsWindow
        or guiClosed then

        return
    end

    if settingsWindow.Visible then
        return
    end

    settingsMinimized =
        false

    settingsMaximized =
        false

    closeFurnitureTypeDropdown(
        false
    )

    settingsContent.Visible =
        true

    settingsResizeHandle.Visible =
        true

    settingsNormalSize =
        UDim2.fromOffset(
            SETTINGS_DEFAULT_WIDTH,
            SETTINGS_DEFAULT_HEIGHT
        )

    settingsNormalPosition =
        UDim2.new(
            0.5,
            -SETTINGS_DEFAULT_WIDTH / 2,
            0.5,
            -SETTINGS_DEFAULT_HEIGHT / 2
        )

    settingsWindow.Position =
        settingsNormalPosition

    settingsWindow.Size =
        UDim2.fromOffset(
            SETTINGS_DEFAULT_WIDTH - 35,
            SETTINGS_DEFAULT_HEIGHT - 25
        )

    settingsWindow.Visible =
        true

    tween(
        settingsWindow,
        {
            Size =
                settingsNormalSize
        },
        0.36,
        Enum.EasingStyle.Back,
        Enum.EasingDirection.Out
    )
end

--// =========================================================
--// Open Furniture
--// =========================================================

local function openFurnitureWindow()

    if not furnitureWindow
        or guiClosed then

        return
    end

    if furnitureWindow.Visible then
        return
    end

    furnitureMinimized =
        false

    furnitureMaximized =
        false

    furnitureContent.Visible =
        true

    furnitureResizeHandle.Visible =
        true

    furnitureNormalSize =
        UDim2.fromOffset(
            FURNITURE_DEFAULT_WIDTH,
            FURNITURE_DEFAULT_HEIGHT
        )

    furnitureNormalPosition =
        UDim2.new(
            0.5,
            -FURNITURE_DEFAULT_WIDTH / 2,
            0.5,
            -FURNITURE_DEFAULT_HEIGHT / 2
        )

    furnitureWindow.Position =
        furnitureNormalPosition

    furnitureWindow.Size =
        UDim2.fromOffset(
            FURNITURE_DEFAULT_WIDTH - 35,
            FURNITURE_DEFAULT_HEIGHT - 25
        )

    furnitureWindow.Visible =
        true

    tween(
        furnitureWindow,
        {
            Size =
                furnitureNormalSize
        },
        0.36,
        Enum.EasingStyle.Back,
        Enum.EasingDirection.Out
    )

    task.spawn(
        refreshFurnitureModels
    )

    task.defer(
        updateFurnitureScrollbar
    )
end

