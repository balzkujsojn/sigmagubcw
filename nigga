    if character then
        table.insert(
            containers,
            character
        )
    end

    if backpack then
        table.insert(
            containers,
            backpack
        )
    end

    for _, container in ipairs(
        containers
    ) do

        for _, tool in ipairs(
            container:GetChildren()
        ) do

            if furnitureToolMatchesCategory(
                tool,
                category
            ) then

                local remote =
                    tool:FindFirstChild(
                        FURNITURE_CONFIG.RemoteName
                    )

                if remote
                    and remote:IsA("RemoteFunction") then

                    return remote, category
                end
            end
        end
    end

    return nil, category
end

--// =========================================================
--// Furniture Filtering
--// =========================================================

local function furnitureMatchesType(
    objectName
)

    local nameLower =
        objectName:lower()

    if selectedFurnitureType ==
        "All" then

        return true
    end

    local isEgg =
        nameLower:find(
            "egg",
            1,
            true
        ) ~= nil

    local isGift =
        nameLower:find(
            "gift",
            1,
            true
        ) ~= nil

    if selectedFurnitureType ==
        "Furniture" then

        return not isEgg
            and not isGift
    end

    if selectedFurnitureType ==
        "Eggs" then

        return isEgg
    end

    if selectedFurnitureType ==
        "Gifts" then

        return isGift
    end

    return true
end

--// =========================================================
--// Furniture Placement Preview / Rotation
--// =========================================================

local function destroyFurniturePreview()

    if furnitureState.previewModel then

        if mouse.TargetFilter ==
            furnitureState.previewModel then

            mouse.TargetFilter = nil
        end

        safeDestroy(
            furnitureState.previewModel
        )

        furnitureState.previewModel =
            nil
    end
end

local function getFurnitureRotationCFrame()

    return CFrame.Angles(
        0,
        math.rad(
            furnitureState.rotation *
            FURNITURE_ROTATION_STEP
        ),
        0
    )
end

local function getFurnitureCenterPart(model)

    if not model then
        return nil
    end

    local center =
        model:FindFirstChild("center", true)

    if center and center:IsA("BasePart") then
        return center
    end

    return nil
end

local function getFurnitureGridBaseTopY()

    return FURNITURE_GRID_TOP_Y
end

local function snapFurnitureGridCoordinate(
    value,
    origin
)

    return origin +
        math.floor(
            ((value - origin) /
            FURNITURE_GRID_SIZE) +
            0.5
        ) *
        FURNITURE_GRID_SIZE
end

local function getFurnitureModelFromTarget(
    target
)

    if not target
        or not target:IsDescendantOf(Workspace) then

        return nil
    end

    local current = target

    while current
        and current ~= Workspace do

        if current:IsA("Model")
            and getFurnitureCenterPart(current) then

            return current
        end

        current = current.Parent
    end

    return nil
end

local function getTargetSurfaceWorldNormal(
    target
)

    if not target
        or not target:IsA("BasePart") then

        return nil
    end

    local normalId = mouse.TargetSurface

    if not normalId then
        return nil
    end

    local localNormal

    if normalId == Enum.NormalId.Top then
        localNormal = Vector3.new(0, 1, 0)
    elseif normalId == Enum.NormalId.Bottom then
        localNormal = Vector3.new(0, -1, 0)
    elseif normalId == Enum.NormalId.Left then
        localNormal = Vector3.new(-1, 0, 0)
    elseif normalId == Enum.NormalId.Right then
        localNormal = Vector3.new(1, 0, 0)
    elseif normalId == Enum.NormalId.Front then
        localNormal = Vector3.new(0, 0, -1)
    elseif normalId == Enum.NormalId.Back then
        localNormal = Vector3.new(0, 0, 1)
    else
        return nil
    end

    return target.CFrame:VectorToWorldSpace(
        localNormal
    )
end

local function getDominantGridStepFromNormal(
    worldNormal
)

    if not worldNormal then
        return nil
    end

    local ax = math.abs(worldNormal.X)
    local ay = math.abs(worldNormal.Y)
    local az = math.abs(worldNormal.Z)

    if ay >= ax and ay >= az then

        return Vector3.new(
            0,
            worldNormal.Y >= 0 and 1 or -1,
            0
        )
    end

    if ax >= az then

        return Vector3.new(
            worldNormal.X >= 0 and 1 or -1,
            0,
            0
        )
    end

    return Vector3.new(
        0,
        0,
        worldNormal.Z >= 0 and 1 or -1
    )
end

local function getCenterHalfExtents(centerPart)

    if not centerPart then
        return nil
    end

    local size = centerPart.Size

    return Vector3.new(
        math.abs(size.X) / 2,
        math.abs(size.Y) / 2,
        math.abs(size.Z) / 2
    )
end

local function getPartExtentAlongWorldNormal(
    part,
    worldNormal
)

    if not part or not worldNormal then
        return nil
    end

    local halfExtents =
        getCenterHalfExtents(part)

    if not halfExtents then
        return nil
    end

    local right = part.CFrame.RightVector
    local up = part.CFrame.UpVector
    local look = part.CFrame.LookVector

    return
        math.abs(worldNormal:Dot(right)) * halfExtents.X +
        math.abs(worldNormal:Dot(up)) * halfExtents.Y +
        math.abs(worldNormal:Dot(look)) * halfExtents.Z
end

local function getSelectedFurnitureCenterExtentAlongWorldNormal(
    model,
    worldNormal
)

    if not model or not worldNormal then
        return nil
    end

    local centerPart =
        getFurnitureCenterPart(model)

    if not centerPart then
        return nil
    end

    local halfExtents =
        getCenterHalfExtents(centerPart)

    if not halfExtents then
        return nil
    end

    -- The placement system rotates furniture around the Y axis in
    -- 90-degree steps. Rotate the center's local axes the same way
    -- when determining how far its boundary extends.
    local rotationCFrame =
        getFurnitureRotationCFrame()

    local right =
        rotationCFrame:VectorToWorldSpace(
            Vector3.new(1, 0, 0)
        )

    local up =
        rotationCFrame:VectorToWorldSpace(
            Vector3.new(0, 1, 0)
        )

    local look =
        rotationCFrame:VectorToWorldSpace(
            Vector3.new(0, 0, -1)
        )

    return
        math.abs(worldNormal:Dot(right)) * halfExtents.X +
        math.abs(worldNormal:Dot(up)) * halfExtents.Y +
        math.abs(worldNormal:Dot(look)) * halfExtents.Z
end

local function getFurnitureGridPlacementCFrame(
    model
)

    if not model then
        return nil
    end

    local target = mouse.Target

    if not target then
        return nil
    end

    local centerPart =
        getFurnitureCenterPart(model)

    if not centerPart then
        return nil
    end

    local targetFurniture =
        getFurnitureModelFromTarget(target)

    local desiredCenterPosition

    if targetFurniture then

        local targetCenter =
            getFurnitureCenterPart(
                targetFurniture
            )

        if not targetCenter then
            return nil
        end

        local worldNormal =
            getTargetSurfaceWorldNormal(target)

        local gridStep =
            getDominantGridStepFromNormal(
                worldNormal
            )

        if not gridStep then
            return nil
        end

        -- The grid is based on the shared `center` part.  The center
        -- can be 4x4x4, 8x8x8, or another size, so use the actual
        -- half-extents of both centers rather than a fixed 4-stud step.
        -- This makes the two center volumes meet exactly on the side
        -- that the player is pointing at.
        local targetExtent =
            getPartExtentAlongWorldNormal(
                targetCenter,
                gridStep
            )

        local newExtent =
            getSelectedFurnitureCenterExtentAlongWorldNormal(
                model,
                gridStep
            )

        if not targetExtent or not newExtent then
            return nil
        end

        desiredCenterPosition =
            targetCenter.Position +
            (gridStep * (targetExtent + newExtent))

    else

        -- The empty build surface is the TOP of the 731 x 2 x 731
        -- workspace base.  The selected model's center bottom face
        -- sits directly on that surface, so its vertical offset is
        -- half of the center's actual Y size.
        local hitPosition =
            mouse.Hit.Position

        local snappedX =
            snapFurnitureGridCoordinate(
                hitPosition.X,
                FURNITURE_GRID_BASE_CENTER.X
            )

        local snappedZ =
            snapFurnitureGridCoordinate(
                hitPosition.Z,
                FURNITURE_GRID_BASE_CENTER.Z
            )

        local centerHalfExtents =
            getCenterHalfExtents(centerPart)

        if not centerHalfExtents then
            return nil
        end

        desiredCenterPosition =
            Vector3.new(
                snappedX,
                getFurnitureGridBaseTopY() +
                    centerHalfExtents.Y,
                snappedZ
            )
    end

    -- Convert the desired center transform back into the model
    -- pivot so the model stays aligned even when its pivot is not
    -- located at the center part.
    local modelPivot =
        model:GetPivot()

    local centerRelativeToPivot =
        modelPivot:ToObjectSpace(
            centerPart.CFrame
        )

    local desiredCenterCFrame =
        CFrame.new(
            desiredCenterPosition
        ) *
        getFurnitureRotationCFrame()

    return desiredCenterCFrame *
        centerRelativeToPivot:Inverse()
end

local function getFurniturePreviewCFrame()

    local model =
        furnitureState.selectedModel

    local gridCFrame =
        getFurnitureGridPlacementCFrame(
            model
        )

    if gridCFrame then
        return gridCFrame
    end

    -- Fallback for any unexpected model without a center part.
    local hitCFrame =
        mouse.Hit

    if not hitCFrame then
        return nil
    end

    return CFrame.new(
        hitCFrame.Position +
        Vector3.new(0, 3, 0)
    ) *
    getFurnitureRotationCFrame()
end

local function prepareFurniturePreview(
    preview
)

    if not preview then
        return
    end

    for _, descendant in ipairs(
        preview:GetDescendants()
    ) do

        if descendant:IsA("BasePart") then

            descendant.Anchored =
                true

            descendant.CanCollide =
                false

            descendant.CanTouch =
                false

            descendant.CanQuery =
                false

            descendant.Massless =
                true

            descendant.Transparency =
                math.max(
                    descendant.Transparency,
                    FURNITURE_PREVIEW_TRANSPARENCY
                )

        elseif descendant:IsA("Decal")
            or descendant:IsA("Texture") then

            descendant.Transparency =
                math.max(
                    descendant.Transparency,
                    FURNITURE_PREVIEW_TRANSPARENCY
                )

        elseif descendant:IsA("ParticleEmitter")
            or descendant:IsA("Trail")
            or descendant:IsA("Beam")
            or descendant:IsA("Smoke")
            or descendant:IsA("Fire")
            or descendant:IsA("Sparkles") then

            descendant.Enabled =
                false

        elseif descendant:IsA("Highlight") then

            descendant.Enabled =
                false

        elseif descendant:IsA("ProximityPrompt")
            or descendant:IsA("ClickDetector") then

            descendant:Destroy()

        elseif descendant:IsA("BillboardGui")
            or descendant:IsA("SurfaceGui") then

            descendant.Enabled =
                false
        end
    end
end

local function updateFurniturePreviewTransform()

    local preview =
        furnitureState.previewModel

    if not preview
        or not preview.Parent then

        return
    end

    local previewCFrame =
        getFurniturePreviewCFrame()

    if not previewCFrame then

        preview.Parent =
            nil

        return
    end

    if preview.Parent ~= Workspace then

        preview.Parent =
            Workspace
    end

    preview:PivotTo(
        previewCFrame
    )
end

local function createFurniturePreview(
    model
)

    destroyFurniturePreview()

    if not model then
        return
    end

    local success, preview =
        pcall(
            function()
                return model:Clone()
            end
        )

    if not success
        or not preview then

        return
    end

    preview.Name =
        "_FurniturePlacementPreview"

    prepareFurniturePreview(
        preview
    )

    preview.Parent =
        Workspace

    -- Keep the placement ghost out of mouse targeting.
    mouse.TargetFilter = preview

    furnitureState.previewModel =
        preview

    updateFurniturePreviewTransform()
end

local function updateFurniturePreview()

    if guiClosed
        or not furnitureWindow
        or not furnitureWindow.Visible
        or not furnitureState.selectedModel
        or not furnitureState.waitingForClick
        or UserInputService:GetFocusedTextBox() then

        if furnitureState.previewModel
            and furnitureState.previewModel.Parent then

            furnitureState.previewModel.Parent =
                nil
        end

        return
    end

    if not furnitureState.previewModel then

        createFurniturePreview(
            furnitureState.selectedModel
        )

        return
    end

    -- After a Shift placement the same preview is kept client-side,
    -- so restore it to Workspace before updating its transform.
    if furnitureState.previewModel.Parent ~= Workspace then

        furnitureState.previewModel.Parent =
            Workspace
    end

    updateFurniturePreviewTransform()
end

local function rotateSelectedFurniture()

    if not furnitureState.selectedModel
        or not furnitureState.waitingForClick
        or UserInputService:GetFocusedTextBox() then

        return
    end

    furnitureState.rotation =
        (
            furnitureState.rotation +
            1
        ) % 4

    updateFurniturePreviewTransform()

    setFurnitureStatus(
        "Selected: " ..
        furnitureState.selectedModel.Name ..
        " (" ..
        tostring(
            furnitureState.rotation *
            FURNITURE_ROTATION_STEP
        ) ..
        "°) → click in game",
        "active"
    )
end

-- Keep the ghost locked to the mouse while selected.
RunService.RenderStepped:Connect(
    updateFurniturePreview
)

UserInputService.InputBegan:Connect(
    function(
        input,
        gameProcessed
    )

        if gameProcessed then
            return
        end

        if input.UserInputType ~=
            Enum.UserInputType.Keyboard then

            return
        end

        if input.KeyCode ==
            Enum.KeyCode.R then

            rotateSelectedFurniture()
        end
    end
)

--// =========================================================
--// Furniture Status
--// =========================================================

setFurnitureStatus = function(
    text,
    state
)

    if not furnitureSelectedValue then
        return
    end

    furnitureState.statusVersion +=
        1

    local currentVersion =
        furnitureState.statusVersion

    local color =
        XP.TextSecondary

    if state == "success" then

        color =
            XP.GreenDark

    elseif state == "error" then

        color =
            XP.RedDark

    elseif state == "active" then

        color =
            XP.BlueDark
    end

    tween(
        furnitureSelectedValue,
        {
            TextTransparency =
                1
        },
        0.12
    )

    task.delay(
        0.12,
        function()

            if currentVersion ~=
                furnitureState.statusVersion then

                return
            end

            furnitureSelectedValue.Text =
                text

            furnitureSelectedValue.TextColor3 =
                color

            tween(
                furnitureSelectedValue,
                {
                    TextTransparency =
                        0
                },
                0.16
            )
        end
    )
end

