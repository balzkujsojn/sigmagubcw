local function tween(
    object,
    properties,
    duration,
    style,
    direction
)
    if not object then
        return nil
    end

    local info = TweenInfo.new(
        duration or 0.25,
        style or Enum.EasingStyle.Quad,
        direction or Enum.EasingDirection.Out
    )

    local tweenObject =
        TweenService:Create(
            object,
            info,
            properties
        )

    tweenObject:Play()

    return tweenObject
end

local function addCorner(parent, radius)
    local corner = Instance.new("UICorner")

    corner.CornerRadius =
        UDim.new(0, radius)

    corner.Parent = parent

    return corner
end

local function addStroke(
    parent,
    color,
    thickness
)
    local stroke = Instance.new("UIStroke")

    stroke.Color = color
    stroke.Thickness =
        thickness or 1

    stroke.ApplyStrokeMode =
        Enum.ApplyStrokeMode.Border

    stroke.Parent = parent

    return stroke
end

local function addGradient(
    parent,
    topColor,
    bottomColor
)
    local gradient =
        Instance.new("UIGradient")

    gradient.Color =
        ColorSequence.new({
            ColorSequenceKeypoint.new(
                0,
                topColor
            ),

            ColorSequenceKeypoint.new(
                1,
                bottomColor
            )
        })

    gradient.Rotation = 90

    gradient.Parent = parent

    return gradient
end

local function safeDestroy(object)

    if not object then
        return
    end

    pcall(function()
        object:Destroy()
    end)
end

local function setResizeCursor(enabled)

    pcall(function()

        if enabled then
            mouse.Icon =
                RESIZE_CURSOR
        else
            mouse.Icon = ""
        end

    end)
end

