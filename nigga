--// =========================================================
--// Clear Furniture Selection
--// =========================================================

local function clearFurnitureSelection()

    destroyFurniturePreview()

    furnitureState.rotation =
        0

    if furnitureState.selectedButton then

        setFurnitureButtonNormal(
            furnitureState.selectedButton
        )

        furnitureState.selectedButton =
            nil
    end

    furnitureState.selectedModel =
        nil

    furnitureState.waitingForClick =
        false

    setFurnitureStatus(
        "Select a model → click in game",
        "normal"
    )
end

--// =========================================================
--// Select Furniture
--// =========================================================

local function selectFurnitureModel(
    model,
    button
)

    if furnitureState.selectedModel ==
        model then

        clearFurnitureSelection()

        return
    end

    if furnitureState.selectedButton then

        setFurnitureButtonNormal(
            furnitureState.selectedButton
        )
    end

    furnitureState.selectedModel =
        model

    furnitureState.selectedButton =
        button

    furnitureState.rotation =
        0

    furnitureState.waitingForClick =
        true

    setFurnitureButtonSelected(
        button
    )

    createFurniturePreview(
        model
    )

    setFurnitureStatus(
        "Selected: " ..
        model.Name ..
        " (0°) → click in game",
        "active"
    )
end

