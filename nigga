                settingsContent.Visible = true
                settingsResizeHandle.Visible = true

                tween(
                    settingsWindow,
                    {
                        Size =
                            settingsNormalSize
                    },
                    0.36,
                    Enum.EasingStyle.Quad
                )

            else

                settingsNormalSize =
                    UDim2.fromOffset(
                        settingsWindow.AbsoluteSize.X,
                        settingsWindow.AbsoluteSize.Y
                    )

                settingsMinimized = true

                settingsContent.Visible = false
                settingsResizeHandle.Visible = false

                tween(
                    settingsWindow,
                    {
                        Size =
                            UDim2.fromOffset(
                                settingsNormalSize.X.Offset,
                                MAIN_MINIMIZED_HEIGHT
                            )
                    },
                    0.36,
                    Enum.EasingStyle.Quad,
                    Enum.EasingDirection.InOut
                )
            end
        end
    )

    --=========================================================
    -- Settings Maximize
    --=========================================================

    settingsMaximizeButton.MouseButton1Click:Connect(
        function()

            if settingsMinimized then
                return
            end

            if not settingsMaximized then

                settingsNormalPosition =
                    settingsWindow.Position

                settingsNormalSize =
                    UDim2.fromOffset(
                        settingsWindow.AbsoluteSize.X,
                        settingsWindow.AbsoluteSize.Y
                    )

                local camera =
                    workspace.CurrentCamera

                local viewport =
                    camera
                    and camera.ViewportSize
                    or Vector2.new(
                        1920,
                        1080
                    )

                settingsMaximized = true

                tween(
                    settingsWindow,
                    {
                        Position =
                            UDim2.fromOffset(
                                10,
                                10
                            ),

                        Size =
                            UDim2.fromOffset(
                                math.max(
                                    SETTINGS_MIN_WIDTH,
                                    viewport.X - 20
                                ),

                                math.max(
                                    SETTINGS_MIN_HEIGHT,
                                    viewport.Y - 20
                                )
                            )
                    },
                    0.36,
                    Enum.EasingStyle.Quad
                )

            else

                settingsMaximized = false

                tween(
                    settingsWindow,
                    {
                        Position =
                            settingsNormalPosition,

                        Size =
                            settingsNormalSize
                    },
                    0.36,
                    Enum.EasingStyle.Quad
                )
            end
        end
    )

    --=========================================================
    -- Settings Close
    --=========================================================

    settingsCloseButton.MouseButton1Click:Connect(
        function()

            tween(
                settingsWindow,
                {
                    Size =
                        UDim2.fromOffset(
                            0,
                            0
                        )
                },
                0.24,
                Enum.EasingStyle.Back,
                Enum.EasingDirection.In
            )

            task.delay(
                0.27,
                function()

                    if settingsWindow then

                        settingsWindow.Visible =
                            false

                        settingsWindow.Position =
                            settingsNormalPosition

                        settingsWindow.Size =
                            settingsNormalSize
                    end
                end
            )
        end
    )
end

--// =========================================================
--// Open Settings
--// =========================================================

local function openSettings()

    if not settingsWindow
        or guiClosed then

        return
    end

    if settingsWindow.Visible then
        return
    end

    settingsMinimized = false
    settingsMaximized = false

    settingsContent.Visible = true
    settingsResizeHandle.Visible = true

    settingsNormalSize =
        UDim2.fromOffset(
            SETTINGS_DEFAULT_WIDTH,
            SETTINGS_DEFAULT_HEIGHT
        )

    settingsNormalPosition =
        UDim2.new(
            0.5,
            -SETTINGS_DEFAULT_WIDTH / 2,
            0.5,
            -SETTINGS_DEFAULT_HEIGHT / 2
        )

    settingsWindow.Position =
        settingsNormalPosition

    settingsWindow.Size =
        UDim2.fromOffset(
            SETTINGS_DEFAULT_WIDTH - 35,
            SETTINGS_DEFAULT_HEIGHT - 25
        )

    settingsWindow.Visible = true

    tween(
        settingsWindow,
        {
            Size =
                settingsNormalSize
        },
        0.36,
        Enum.EasingStyle.Back,
        Enum.EasingDirection.Out
    )
end

