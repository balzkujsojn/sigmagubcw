                        furnitureWindow.AbsoluteSize.X,
                        furnitureWindow.AbsoluteSize.Y
                    )

                local camera =
                    workspace.CurrentCamera

                local viewport =
                    camera
                    and camera.ViewportSize
                    or Vector2.new(
                        1920,
                        1080
                    )

                furnitureMaximized =
                    true

                tween(
                    furnitureWindow,
                    {
                        Position =
                            UDim2.fromOffset(
                                10,
                                10
                            ),

                        Size =
                            UDim2.fromOffset(
                                math.max(
                                    FURNITURE_MIN_WIDTH,
                                    viewport.X - 20
                                ),

                                math.max(
                                    FURNITURE_MIN_HEIGHT,
                                    viewport.Y - 20
                                )
                            )
                    },
                    0.36,
                    Enum.EasingStyle.Quad
                )

            else

