        false

    button.ZIndex =
        zIndex or 5

    button.Parent =
        parent

    addStroke(
        button,
        XP.BorderDark,
        1
    )

    if rounded then

        addCorner(
            button,
            3
        )
    end

    local highlight =
        Instance.new("Frame")

    highlight.Size =
        UDim2.new(
            1,
            -2,
            1,
            -2
        )

    highlight.Position =
        UDim2.fromOffset(
            1,
            1
        )

    highlight.BackgroundTransparency =
        1

    highlight.BorderSizePixel =
        0

    highlight.ZIndex =
        (zIndex or 5) + 1

    highlight.Parent =
        button

    if rounded then

        addCorner(
            highlight,
            2
        )
    end

    addStroke(
        highlight,
        XP.BorderLight,
        1
    )

    local gradient =
        addGradient(
            button,
            XP.ButtonTop,
            XP.ButtonBottom
        )

    local originalPosition =
        position

    button.MouseEnter:Connect(
        function()

            if button:GetAttribute(
