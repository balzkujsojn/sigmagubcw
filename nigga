                currentIndex = index

                break
            end
        end

        if currentIndex then

            table.remove(
                activeErrorWindows,
                currentIndex
            )
        end

        local closePosition =
            errorWindow.Position

        tween(
            errorWindow,
            {
                Size =
                    UDim2.fromOffset(
                        0,
                        0
                    ),

                Position =
                    UDim2.fromOffset(
                        closePosition.X.Offset + 15,
                        closePosition.Y.Offset + 15
                    )
            },
            0.22,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.In
        )

        task.delay(
            0.24,
            function()

                safeDestroy(
                    errorWindow
                )

                for index, data in ipairs(
                    activeErrorWindows
                ) do

                    if data.window
                        and data.window.Parent then

                        tween(
                            data.window,
                            {
                                Position =
                                    getErrorStackPosition(
                                        index
                                    )
                            },
                            0.25,
                            Enum.EasingStyle.Quad,
                            Enum.EasingDirection.Out
                        )
                    end
                end
            end
        )
    end

