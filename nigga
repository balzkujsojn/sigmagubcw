        if old then
            old:Destroy()
        end
    end)

    gui =
        Instance.new("ScreenGui")

    gui.Name =
        "SexyBlaster9000"

    gui.ResetOnSpawn =
        false

    gui.IgnoreGuiInset =
        true

    gui.ZIndexBehavior =
        Enum.ZIndexBehavior.Sibling

    local parentGui

    pcall(function()

        if typeof(gethui) ==
            "function" then

            parentGui =
                gethui()
        end
    end)

    if not parentGui then
        parentGui =
            CoreGui
    end

    pcall(function()

        if syn
            and syn.protect_gui then

            syn.protect_gui(gui)
        end
    end)

    gui.Parent =
        parentGui

    createMainWindow(gui)
    createSettingsWindow(gui)

    settingsButton.MouseButton1Click:Connect(
        function()

            if settingsWindow
                and settingsWindow.Visible then

                return
            end

            openSettings()
        end
    )

    updateStatus()
    updateTarget()
    updateAutoEquip()

    --=========================================================
    -- Opening Animation
    --=========================================================

    mainWindow.Size =
        UDim2.fromOffset(
            40,
            8
        )

    mainWindow.Position =
        UDim2.new(
            0.5,
            -20,
            0.5,
            -4
        )

    mainNormalPosition =
        UDim2.new(
            0.5,
            -MAIN_DEFAULT_WIDTH / 2,
            0.5,
            -MAIN_DEFAULT_HEIGHT / 2
        )

    mainNormalSize =
        UDim2.fromOffset(
            MAIN_DEFAULT_WIDTH,
            MAIN_DEFAULT_HEIGHT
        )

    mainRestoreSize =
        mainNormalSize

    tween(
        mainWindow,
        {
            Size =
                mainNormalSize,

            Position =
                mainNormalPosition
        },
        0.36,
        Enum.EasingStyle.Back,
        Enum.EasingDirection.Out
    )

    return gui
end

--// =========================================================
--// Public API
--// =========================================================

local API = {}

function API.Start()

    if not hasEquinoxCannon() then

        State.isRunning = false
        State.shootingEnabled = false

        updateStatus()

        showCannonMissingError()

        return false
    end

    State.playerAlive =
        isPlayerAlive()

    State.isRunning = true
    State.shootingEnabled = true

    State.shootingErrors = 0
    State.lastFireTime = 0

    updateStatus()

    return true
end

function API.Stop()

    State.isRunning = false
    State.shootingEnabled = false

    State.currentTarget = nil
    State.currentTargetName = "None"

    updateStatus()
    updateTarget()
end

function API.SetTarget(target)

    if typeof(target) == "Instance" then

        State.currentTarget =
            target

        State.currentTargetName =
            target.Name or "None"

    elseif typeof(target) == "table"
        and target.Model
        and target.TargetPart then

        State.currentTarget =
            target

        State.currentTargetName =
            target.Name
            or target.Model.Name
            or "None"

    elseif typeof(target) == "string" then

        State.currentTarget = nil
        State.currentTargetName = target

    else

        State.currentTarget = nil
        State.currentTargetName = "None"
    end

    updateTarget()
end

function API.SetPlayerAlive(alive)

    State.playerAlive =
        alive == true
end

function API.SetShootingEnabled(enabled)

    State.shootingEnabled =
        enabled == true

    updateStatus()
end

function API.SetShootingErrors(count)

    State.shootingErrors =
        math.max(
            0,
            tonumber(count) or 0
        )
end

function API.SetAutoEquip(enabled)

    if enabled then

        if not hasEquinoxCannon() then

            State.autoEquip = false

            updateAutoEquip()

            showCannonMissingError()

            return false
        end
    end

    State.autoEquip =
        enabled == true

    updateAutoEquip()

    return true
end

function API.HasEquinoxCannon()

    return hasEquinoxCannon()
end

function API.GetStatus()

    return {
        Running =
            State.isRunning,

        CurrentTarget =
            State.currentTargetName
            or "None",

        PlayerAlive =
            State.playerAlive,

        ShootingEnabled =
            State.shootingEnabled,

        ShootingErrors =
            State.shootingErrors,

        LastShotTime =
            State.lastFireTime,

        AutoEquip =
            State.autoEquip,

        HasEquinoxCannon =
            hasEquinoxCannon()
    }
end

--// =========================================================
--// Initialize
--// =========================================================

createGUI()

State.playerAlive =
    isPlayerAlive()

updateStatus()
updateTarget()
updateAutoEquip()

--// =========================================================
--// Main Firing Worker
--// =========================================================

task.spawn(
    function()

        while not guiClosed do

            State.playerAlive =
                isPlayerAlive()

            if State.isRunning
                and State.playerAlive then

                if State.autoEquip then
                    autoEquipTool()
                end

                if State.shootingEnabled then
                    attemptFire()
                end

            else

                State.currentTarget = nil
                State.currentTargetName = "None"
            end

            RunService.Heartbeat:Wait()
        end
    end
)

--// =========================================================
--// Target Worker
--// =========================================================

task.spawn(
    function()

        while not guiClosed do

            if State.isRunning
                and State.playerAlive
                and State.shootingEnabled then

                local target =
                    selectTarget()

                State.currentTarget =
                    target

                if target then

                    State.currentTargetName =
                        target.Name
                        or (
                            target.Model
                            and target.Model.Name
                        )
                        or "None"

                else

                    State.currentTargetName =
                        "None"
                end

            else

                State.currentTarget = nil
                State.currentTargetName = "None"
            end

            task.wait(0.3)
        end
    end
)

--// =========================================================
--// UI Refresh
--// =========================================================

task.spawn(
    function()

        while gui
            and gui.Parent
            and not guiClosed do

            State.playerAlive =
                isPlayerAlive()

            updateStatus()
            updateTarget()
            updateAutoEquip()

            task.wait(0.15)
        end
    end
)

return API
