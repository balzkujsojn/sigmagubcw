--// =========================================================
--// Furniture Scrollbar
--// =========================================================

updateFurnitureScrollbar =
    function()

        if not furnitureScroll
            or not furnitureScrollTrack
            or not furnitureScrollThumb then

            return
        end

        local trackHeight =
            furnitureScrollTrack.AbsoluteSize.Y

        if trackHeight <= 0 then
            return
        end

        local viewportHeight =
            furnitureScroll.AbsoluteSize.Y

        local canvasHeight =
            furnitureScroll.AbsoluteCanvasSize.Y

        local maxCanvas =
            math.max(
                0,
                canvasHeight -
                viewportHeight
            )

        if maxCanvas <= 0 then

            furnitureScrollThumb.Size =
                UDim2.new(
                    1,
                    -2,
                    1,
                    -2
                )

            furnitureScrollThumb.Position =
                UDim2.fromOffset(
                    1,
                    1
                )

            return
        end

        local ratio =
            math.clamp(
                viewportHeight /
                    canvasHeight,
                0.08,
                1
            )

        local thumbHeight =
            math.floor(
                trackHeight *
                ratio
            )

        thumbHeight =
            math.max(
                28,
                thumbHeight
            )

        thumbHeight =
            math.min(
                trackHeight,
                thumbHeight
            )

        local usableTrack =
            math.max(
                1,
                trackHeight -
                thumbHeight
            )

        local scrollRatio =
            math.clamp(
                furnitureScroll.CanvasPosition.Y /
                    maxCanvas,
                0,
                1
            )

        local thumbY =
            usableTrack *
            scrollRatio

        furnitureScrollThumb.Size =
            UDim2.new(
                1,
                -2,
                0,
                thumbHeight
            )

        furnitureScrollThumb.Position =
            UDim2.fromOffset(
                1,
                thumbY
            )
    end

furnitureScrollBy =
    function(
        amount
    )

        if not furnitureScroll then
            return
        end

        local maxCanvas =
            math.max(
                0,
                furnitureScroll.AbsoluteCanvasSize.Y -
                furnitureScroll.AbsoluteSize.Y
            )

        furnitureScroll.CanvasPosition =
            Vector2.new(
                0,
                math.clamp(
                    furnitureScroll.CanvasPosition.Y +
                        amount,
                    0,
                    maxCanvas
                )
            )

        updateFurnitureScrollbar()
    end

--// =========================================================
--// Refresh Furniture Models
--// =========================================================

local function refreshFurnitureModels()

    if furnitureState.refreshing then
        return
    end

    furnitureState.refreshing =
        true

    clearFurnitureSelection()

    for _, button in ipairs(
        furnitureState.modelButtons
    ) do

        if button
            and button.Parent then

            tween(
                button,
                {
                    BackgroundTransparency =
                        1,

                    TextTransparency =
                        1
                },
                0.08
            )
        end
    end

    task.wait(
        0.09
    )

    for _, button in ipairs(
        furnitureState.modelButtons
    ) do

        safeDestroy(
            button
        )
    end

    furnitureState.modelButtons =
        {}

    local folder =
        ReplicatedStorage:FindFirstChild(
            "Blocks"
        )

    if not folder then

        setFurnitureStatus(
            "Blocks folder not found",
            "error"
        )

        furnitureState.refreshing =
            false

        return
    end

    local searchText =
        ""

    if furnitureSearchBox then

        searchText =
            furnitureSearchBox.Text:lower()
    end

    local count =
        0

    for _, object in ipairs(
        folder:GetChildren()
    ) do

        if object:IsA("Model") then

            local nameLower =
                object.Name:lower()

            local matchesSearch =
                searchText == ""
                or
                nameLower:find(
                    searchText,
                    1,
                    true
                )

            local matchesType =
                furnitureMatchesType(
                    object.Name
                )

            if matchesSearch
                and matchesType then

                count +=
                    1

                createFurnitureModelButton(
                    object,
                    count
                )
            end
        end
    end

    furnitureScroll.CanvasPosition =
        Vector2.new(
            0,
            0
        )

    task.defer(
        updateFurnitureScrollbar
    )

    if count == 0 then

        setFurnitureStatus(
            "No matching models",
            "error"
        )

    else

        setFurnitureStatus(
            tostring(count) ..
            " model" ..
            (
                count == 1
                and ""
                or "s"
            ) ..
            " available",
            "normal"
        )
    end

    furnitureState.refreshing =
        false
end

--// =========================================================
--// Furniture Spawning
--// =========================================================

local function furnitureMouseSpawn()

    if not furnitureState.waitingForClick then
        return
    end

    if not furnitureState.selectedModel then
        return
    end

    if UserInputService:GetFocusedTextBox() then
        return
    end

    local target =
        mouse.Target

    if not target then
        return
    end

    furnitureState.waitingForClick =
        false

    local modelToSpawn =
        furnitureState.selectedModel

    setFurnitureStatus(
        "Spawning " ..
        modelToSpawn.Name ..
        "...",
        "active"
    )

    local rotationIndex =
        furnitureState.rotation

    local placementCFrame =
        getFurnitureGridPlacementCFrame(
            modelToSpawn
        )

    if not placementCFrame then

        placementCFrame =
            CFrame.new(
                mouse.Hit.Position +
                Vector3.new(0, 3, 0)
            ) *
            getFurnitureRotationCFrame()
    end

    local args = {

        [1] =
            "placeobject",

        [2] = {

            [1] =
                modelToSpawn,

            [2] =
                furnitureBaseFolder,

            [3] =
                placementCFrame,

            [4] =
                rotationIndex
        }
    }

    local remote, furnitureCategory =
        getFurnitureRemote(
            modelToSpawn.Name
        )

    if not remote then

        furnitureState.waitingForClick =
            true

        setFurnitureStatus(
            "Selected: " ..
            modelToSpawn.Name ..
            " (" ..
            tostring(
                furnitureState.rotation *
                FURNITURE_ROTATION_STEP
            ) ..
            "°) → click in game",
            "active"
        )

        showFurnitureMissingError(
            furnitureCategory
        )

        return
    end

    local success, err =
        pcall(
            function()

                remote:InvokeServer(
                    unpack(args)
                )
            end
        )

    if success then

        if isShiftHeld() then

            furnitureState.waitingForClick =
                true

            -- Keep the same client-side preview alive for repeated
            -- placement and immediately move it to the next cursor cell.
            if not furnitureState.previewModel then

                createFurniturePreview(
                    modelToSpawn
                )

            else

                furnitureState.previewModel.Parent =
                    Workspace

                updateFurniturePreviewTransform()

            end

            setFurnitureStatus(
                "Spawned " ..
                modelToSpawn.Name ..
                " (" ..
                tostring(
                    furnitureState.rotation *
                    FURNITURE_ROTATION_STEP
                ) ..
                "°) → click again",
                "success"
            )

        else

            clearFurnitureSelection()
        end

    else

        setFurnitureStatus(
            "Spawn failed: " ..
            modelToSpawn.Name,
            "error"
        )

        for index, button in ipairs(
            furnitureState.modelButtons
        ) do

            if button
                and button.Parent
                and button.Text ==
                    modelToSpawn.Name then

                local gradient =
                    button:FindFirstChildOfClass(
                        "UIGradient"
                    )

                if gradient then
                    gradient.Enabled =
                        false
                end

                tween(
                    button,
                    {
                        BackgroundColor3 =
                            XP.Red,

                        TextColor3 =
                            Color3.fromRGB(
                                255,
                                255,
                                255
                            )
                    },
                    0.12
                )

                task.delay(
                    0.15,
                    function()

                        safeDestroy(
                            button
                        )
                    end
                )

                table.remove(
                    furnitureState.modelButtons,
                    index
                )

                break
            end
        end

        task.wait(
            0.15
        )

        destroyFurniturePreview()

        furnitureState.selectedModel =
            nil

        furnitureState.selectedButton =
            nil

        furnitureState.rotation =
            0

        furnitureState.waitingForClick =
            false

        setFurnitureStatus(
            "Spawn failed",
            "error"
        )

        warn(
            "Furniture spawn error: " ..
            tostring(err)
        )
    end
end

