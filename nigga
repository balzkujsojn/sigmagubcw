local function isPlayerAlive()

    if not player.Character then
        return false
    end

    local humanoid =
        player.Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return false
    end

    return humanoid.Health > 0
end

local function hasEquinoxCannon()

    local character =
        player.Character

    if character then

        local equippedTool =
            character:FindFirstChild(
                CONFIG.TOOL_NAME
            )

        if equippedTool
            and equippedTool:IsA("Tool") then

            return true
        end
    end

    local backpack =
        player:FindFirstChildOfClass(
            "Backpack"
        )

    if backpack then

        local inventoryTool =
            backpack:FindFirstChild(
                CONFIG.TOOL_NAME
            )

        if inventoryTool
            and inventoryTool:IsA("Tool") then

            return true
        end
    end

    return false
end

local function getFurnitureCategory(
    modelName
)

    local nameLower =
        tostring(
            modelName or ""
        ):lower()

    if nameLower:find(
        "egg",
        1,
        true
    ) then

        return "Eggs"
    end

    if nameLower:find(
        "gift",
        1,
        true
    ) then

        return "Gifts"
    end

    return "Furniture"
end

local function furnitureToolMatchesCategory(
    tool,
    category
)

    if not tool
        or not tool:IsA("Tool") then

        return false
    end

    local toolName =
        tool.Name

    local nameLower =
        toolName:lower()

    if category == "Furniture" then

        return toolName ==
            FURNITURE_CONFIG.NormalToolName
    end

    if category == "Eggs" then

        if nameLower == "egg"
            or nameLower ==
                "ominous dark egg" then

            return false
        end

        return nameLower:find(
            "egg",
            1,
            true
        ) ~= nil
    end

    if category == "Gifts" then

        return nameLower:find(
            "gift",
            1,
            true
        ) ~= nil
    end

    return false
end

