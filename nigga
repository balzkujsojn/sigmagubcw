local FURNITURE_TYPE_DROPDOWN_OPTION_HEIGHT =
    19

local FURNITURE_TYPE_DROPDOWN_HEIGHT =
    (#FURNITURE_TYPE_OPTIONS * FURNITURE_TYPE_DROPDOWN_OPTION_HEIGHT) + 2

local function openFurnitureTypeDropdown()

    if not furnitureTypeDropdown
        or not settingsWindow
        or furnitureTypeDropdownOpen then

        return
    end

    if settingsMinimized then
        return
    end

    furnitureTypeDropdownOpen =
        true

    furnitureTypeDropdownAnimationToken +=
        1

    local currentToken =
        furnitureTypeDropdownAnimationToken

    furnitureTypeDropdown.Visible =
        true

    furnitureTypeDropdown.Position =
        UDim2.fromOffset(
            0,
            134
        )

    furnitureTypeDropdown.Size =
        UDim2.new(
            1,
            0,
            0,
            0
        )

    --// Animate only the drop list; the arrow remains completely static.
    tween(
        furnitureTypeDropdown,
        {
            Size =
                UDim2.new(
                    1,
                    0,
                    0,
                    FURNITURE_TYPE_DROPDOWN_HEIGHT
                )
        },
        0.16,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )
end

local function closeFurnitureTypeDropdown(
    animated
)

    if not furnitureTypeDropdown then
        return
    end

    furnitureTypeDropdownOpen =
        false

    furnitureTypeDropdownAnimationToken +=
        1

    local currentToken =
        furnitureTypeDropdownAnimationToken

    if not animated then

        furnitureTypeDropdown.Visible =
            false

        furnitureTypeDropdown.Size =
            UDim2.new(
                1,
                0,
                0,
                0
            )

        return
    end

    tween(
        furnitureTypeDropdown,
        {
            Size =
                UDim2.new(
                    1,
                    0,
                    0,
                    0
                )
        },
        0.12,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.In
    )

    task.delay(
        0.13,
        function()

            if currentToken ~=
                furnitureTypeDropdownAnimationToken
                or furnitureTypeDropdownOpen then

                return
            end

            furnitureTypeDropdown.Visible =
                false
        end
    )
end

