    )

    button.MouseLeave:Connect(
        function()

            if button:GetAttribute(
                "Pressed"
            ) then

                return
            end

            gradient.Color =
                ColorSequence.new({

                    ColorSequenceKeypoint.new(
                        0,
                        XP.ButtonTop
                    ),

                    ColorSequenceKeypoint.new(
                        1,
                        XP.ButtonBottom
                    )
