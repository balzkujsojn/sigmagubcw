        Enum.TextXAlignment.Center

    okText.TextYAlignment =
        Enum.TextYAlignment.Center

    okText.ZIndex =
        errorWindow.ZIndex + 8

    okText.Parent =
        okButton

    --=========================================================
    -- Dragging
    --=========================================================

    enableDragging(
        errorWindow,
        errorTitleBar,
        "error"
    )

    --=========================================================
    -- Close
    --=========================================================

    local function closeError()

        local currentIndex

        for index, data in ipairs(
            activeErrorWindows
        ) do

            if data.window ==
                errorWindow then

                currentIndex = index

                break
            end
        end

        if currentIndex then

            table.remove(
                activeErrorWindows,
                currentIndex
            )
        end

        local closePosition =
            errorWindow.Position

        tween(
            errorWindow,
            {
                Size =
                    UDim2.fromOffset(
                        0,
                        0
                    ),

                Position =
                    UDim2.fromOffset(
                        closePosition.X.Offset + 15,
                        closePosition.Y.Offset + 15
                    )
            },
            0.22,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.In
        )

        task.delay(
            0.24,
            function()

                safeDestroy(
                    errorWindow
                )

                -- Recalculate the cascade after closing.
                for index, data in ipairs(
                    activeErrorWindows
                ) do

                    if data.window
                        and data.window.Parent then

                        tween(
                            data.window,
                            {
                                Position =
                                    getErrorStackPosition(
                                        index
                                    )
                            },
                            0.25,
                            Enum.EasingStyle.Quad,
                            Enum.EasingDirection.Out
                        )
                    end
                end
            end
        )
    end

    closeButton.MouseButton1Click:Connect(
        closeError
    )

    okButton.MouseButton1Click:Connect(
        closeError
    )

    table.insert(
        activeErrorWindows,
        {
            window = errorWindow
        }
    )

    --=========================================================
    -- Opening animation
    --=========================================================

    local targetPosition =
        errorWindow.Position

    errorWindow.Position =
        UDim2.fromOffset(
            targetPosition.X.Offset + 20,
            targetPosition.Y.Offset + 20
        )

    errorWindow.Size =
        UDim2.fromOffset(
            ERROR_DEFAULT_WIDTH - 30,
            ERROR_DEFAULT_HEIGHT - 25
        )

    tween(
        errorWindow,
        {
            Position =
                targetPosition,

            Size =
                UDim2.fromOffset(
                    ERROR_DEFAULT_WIDTH,
                    ERROR_DEFAULT_HEIGHT
                )
        },
        0.36,
        Enum.EasingStyle.Back,
        Enum.EasingDirection.Out
    )

    return errorWindow
end

