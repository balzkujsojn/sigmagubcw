                    settingsWindow.Position

                settingsNormalSize =
                    UDim2.fromOffset(
                        settingsWindow.AbsoluteSize.X,
                        settingsWindow.AbsoluteSize.Y
                    )

                local camera =
                    workspace.CurrentCamera

                local viewport =
                    camera
                    and camera.ViewportSize
                    or Vector2.new(
                        1920,
                        1080
                    )

                settingsMaximized =
                    true

                tween(
                    settingsWindow,
                    {
                        Position =
                            UDim2.fromOffset(
                                10,
                                10
                            ),

                        Size =
                            UDim2.fromOffset(
                                math.max(
                                    SETTINGS_MIN_WIDTH,
                                    viewport.X - 20
                                ),

                                math.max(
                                    SETTINGS_MIN_HEIGHT,
                                    viewport.Y - 20
                                )
                            )
                    },
                    0.36,
                    Enum.EasingStyle.Quad
                )

            else

                settingsMaximized =
                    false

                tween(
                    settingsWindow,
                    {
                        Position =
                            settingsNormalPosition,

                        Size =
                            settingsNormalSize
                    },
                    0.36,
                    Enum.EasingStyle.Quad
                )
            end
        end
    )

    --=========================================================
    -- Settings Close
    --=========================================================

    settingsCloseButton.MouseButton1Click:Connect(
        function()

            closeFurnitureTypeDropdown(
                false
            )

            tween(
                settingsWindow,
                {
                    Size =
                        UDim2.fromOffset(
