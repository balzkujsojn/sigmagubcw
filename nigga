--// =========================================================
--// GUI Creation
--// =========================================================

local function createGUI()

    pcall(function()

        local old =
            CoreGui:FindFirstChild(
                "SexyBlaster9000"
            )

        if old then
            old:Destroy()
        end
    end)

    gui =
        Instance.new("ScreenGui")

    gui.Name =
        "SexyBlaster9000"

    gui.ResetOnSpawn =
        false

    gui.IgnoreGuiInset =
        true

    gui.ZIndexBehavior =
        Enum.ZIndexBehavior.Sibling

    local parentGui

    pcall(function()

        if typeof(gethui) ==
            "function" then

            parentGui =
                gethui()
        end
    end)

    if not parentGui then
        parentGui =
            CoreGui
    end

    pcall(function()

        if syn
            and syn.protect_gui then

            syn.protect_gui(gui)
        end
    end)

    gui.Parent =
        parentGui

    createMainWindow(gui)
    createSettingsWindow(gui)

    settingsButton.MouseButton1Click:Connect(
        function()

            if settingsWindow
                and settingsWindow.Visible then

                return
            end

            openSettings()
        end
    )

    updateStatus()
    updateTarget()
    updateAutoEquip()

    --=========================================================
    -- Opening animation
    --=========================================================

    mainWindow.Size =
        UDim2.fromOffset(
            40,
            8
        )

    mainWindow.Position =
        UDim2.new(
            0.5,
            -20,
            0.5,
            -4
        )

    mainNormalPosition =
        UDim2.new(
            0.5,
            -MAIN_DEFAULT_WIDTH / 2,
            0.5,
            -MAIN_DEFAULT_HEIGHT / 2
        )

    mainNormalSize =
        UDim2.fromOffset(
            MAIN_DEFAULT_WIDTH,
            MAIN_DEFAULT_HEIGHT
        )

    mainRestoreSize =
        mainNormalSize

    tween(
        mainWindow,
        {
            Size =
                mainNormalSize,

            Position =
                mainNormalPosition
        },
        0.36,
        Enum.EasingStyle.Back,
        Enum.EasingDirection.Out
    )

    return gui
end

--// =========================================================
--// Public API
--// =========================================================

local API = {}

function API.Start()

    if not hasEquinoxCannon() then

        State.isRunning = false

        updateStatus()

        showCannonMissingError()

        return false
    end

    State.isRunning = true

    updateStatus()

    return true
end

function API.Stop()

    State.isRunning = false

    State.currentTarget = nil
    State.currentTargetName = "None"

    updateStatus()
    updateTarget()
end

function API.SetTarget(target)

    if typeof(target) == "Instance" then

        State.currentTarget =
            target

        State.currentTargetName =
            target.Name or "None"

    elseif typeof(target) == "string" then

        State.currentTarget = nil
        State.currentTargetName = target

    else

        State.currentTarget = nil
        State.currentTargetName = "None"
    end

    updateTarget()
end

function API.SetPlayerAlive(alive)

    State.playerAlive =
        alive == true
end

function API.SetShootingEnabled(enabled)

    State.shootingEnabled =
        enabled == true
end

function API.SetShootingErrors(count)

    State.shootingErrors =
        math.max(
            0,
            tonumber(count) or 0
        )
end

function API.SetAutoEquip(enabled)

    if enabled then

        if not hasEquinoxCannon() then

            State.autoEquip = false

            updateAutoEquip()

            showCannonMissingError()

            return false
        end
    end

    State.autoEquip =
        enabled == true

    updateAutoEquip()

    return true
end

function API.HasEquinoxCannon()

    return hasEquinoxCannon()
end

function API.GetStatus()

    return {
        Running =
            State.isRunning,

        CurrentTarget =
            State.currentTargetName
            or "None",

        PlayerAlive =
            State.playerAlive,

        ShootingEnabled =
            State.shootingEnabled,

        ShootingErrors =
            State.shootingErrors,

        LastShotTime =
            State.lastFireTime,

        AutoEquip =
            State.autoEquip,

        HasEquinoxCannon =
            hasEquinoxCannon()
    }
end

--// =========================================================
--// Initialize
--// =========================================================

createGUI()

State.playerAlive =
    isPlayerAlive()

updateStatus()
updateTarget()
updateAutoEquip()

--// =========================================================
--// UI Refresh
--// =========================================================

task.spawn(function()

    while gui
        and gui.Parent
        and not guiClosed do

        State.playerAlive =
            isPlayerAlive()

        updateStatus()
        updateTarget()
        updateAutoEquip()

        task.wait(0.15)
    end
end)

return API
