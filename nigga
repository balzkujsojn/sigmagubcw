    furnitureScrollThumb.InputBegan:Connect(
        function(input)

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton1
                and input.UserInputType
                ~= Enum.UserInputType.Touch then

                return
            end

            furnitureState.scrollbarDragging =
                true

            furnitureState.scrollbarDragStart =
                input.Position

            furnitureState.scrollbarStartCanvasY =
                furnitureScroll.CanvasPosition.Y
        end
    )

    furnitureScrollThumb.InputEnded:Connect(
        function(input)

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton1
                and input.UserInputType
                ~= Enum.UserInputType.Touch then

                return
            end

            furnitureState.scrollbarDragging =
                false
        end
    )

    UserInputService.InputChanged:Connect(
        function(input)

            if not furnitureState.scrollbarDragging then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseMovement
                and input.UserInputType
                ~= Enum.UserInputType.Touch then

                return
            end

            local delta =
                input.Position -
                furnitureState.scrollbarDragStart

            local trackHeight =
                furnitureScrollTrack.AbsoluteSize.Y

            local thumbHeight =
                furnitureScrollThumb.AbsoluteSize.Y

            local maxThumbPosition =
                math.max(
                    1,
                    trackHeight -
                    thumbHeight
                )

            local maxCanvas =
                math.max(
                    0,
                    furnitureScroll.AbsoluteCanvasSize.Y -
                    furnitureScroll.AbsoluteSize.Y
                )

            local canvasDelta =
                (
                    delta.Y /
                    maxThumbPosition
                ) *
                maxCanvas

            furnitureScroll.CanvasPosition =
                Vector2.new(
                    0,
                    math.clamp(
                        furnitureState.scrollbarStartCanvasY +
                            canvasDelta,
                        0,
                        maxCanvas
                    )
                )

            updateFurnitureScrollbar()
        end
    )

    furnitureScroll:GetPropertyChangedSignal(
        "CanvasPosition"
    ):Connect(
        function()

            updateFurnitureScrollbar()
        end
    )

